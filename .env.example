# Public site URL (canonical, Open Graph, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Home page for `page(id: …, idType: URI)` (slug/path as WPGraphQL expects, often `home`).
# NEXT_PUBLIC_WORDPRESS_HOME_PAGE_URI=home

# WordPress origin (media + GraphQL). No trailing slash.
# Placeholder hosts (*.example.com) are ignored until you set a real URL, so local dev works without WP.
NEXT_PUBLIC_WORDPRESS_URL=https://nourbelletours.nextige.com

# Optional: "false" / "0" = never call GraphQL. "true" / "1" = allow even *.example.com (rare).
# NEXT_PUBLIC_WORDPRESS_GRAPHQL=true

# Optional: WPGraphQL auth for draft previews (Application Password or JWT).
# WORDPRESS_GRAPHQL_AUTH_HEADER=Basic xxxxx

# Optional: comma-separated WPGraphQL plural root field names for CPTs in sitemap.
# Example: tours,excursions
# WP_SITEMAP_CONTENT_TYPES=posts,pages,tours
